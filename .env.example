# 复制为 .env 后填写。不要提交真实值。
LYRADB_IMAGE_TAG=3.1.2
LYRADB_PORT=8080
LYRADB_EDITION=enterprise

# 至少 32 位随机字符串，分别用于连接凭据加密与 H2 元数据库。
JASYPT_PASSWORD=请替换为独立的高强度随机密钥
LYRADB_DB_PASSWORD=请替换为独立的高强度数据库密码

# 仅企业空用户库首次启动时创建管理员。密码须为 12–128 位，
# 包含大小写字母、数字、特殊字符，且不得包含用户名。
# 首次初始化成功后请删除或置空下面两项，避免引导口令长期驻留环境。
LYRADB_BOOTSTRAP_ADMIN_USERNAME=admin
LYRADB_BOOTSTRAP_ADMIN_PASSWORD=请替换为管理员强密码
LYRADB_BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员
LYRADB_BOOTSTRAP_ADMIN_EMAIL=

# HTTPS 反向代理对外地址。多项用逗号分隔。
CORS_ALLOWED_ORIGINS=https://db.example.com
LYRADB_COOKIE_SECURE=true

# 留空表示禁止对应出站能力；按需填写精确主机或受控 *.example.com。
LYRADB_WEBHOOK_ALLOWED_HOSTS=
LYRADB_AI_ALLOWED_HOSTS=
