                "defaultValue": 8443
            },
            {
                "name": "database",
                "label": "数据库名",
                "type": "text",
                "required": false,
                "defaultValue": "default"
            },
            {
                "name": "username",
                "label": "用户名",
                "type": "text",
                "required": false
            },
            {
                "name": "password",
                "label": "密码",
                "type": "password",
                "required": false
            }
        ]
    },
    {
        "dbType": "MAXCOMPUTE",
        "displayName": "MaxCompute",
        "driverType": "jdbc",
        "driverClass": "com.aliyun.odps.jdbc.OdpsDriver",
        "mavenCoordinates": {
            "groupId": "com.aliyun.odps",
            "artifactId": "odps-jdbc",
            "version": "3.8.6",
            "classifier": "jar-with-dependencies"
        },
        "connectionUrlTemplate": "jdbc:odps:{endpoint}?project={project}",
        "defaultPort": 0,
        "capabilities": {
            "supportsTransaction": false,
            "supportsDML": true,
            "supportsDDL": true,
            "supportsPartition": true,
            "supportsViews": true,
            "supportsProcedures": false,
            "supportsFunctions": true,
            "supportsIndexes": false,
            "supportsTriggers": false,
            "supportsSSL": true,
            "readOnly": true,
            "supportsMaxComputePartition": true
        },
        "connectionFormFields": [
            {
                "name": "endpoint",
                "label": "Endpoint",
                "type": "select",
                "required": true,
                "options": [
                    {
                        "label": "华东1(杭州)",
                        "value": "https://service.cn-hangzhou.maxcompute.aliyun.com/api"
                    },
                    {
                        "label": "华东2(上海)",
                        "value": "https://service.cn-shanghai.maxcompute.aliyun.com/api"
                    },
                    {
                        "label": "华北2(北京)",
                        "value": "https://service.cn-beijing.maxcompute.aliyun.com/api"
                    },
                    {
                        "label": "华南1(深圳)",
                        "value": "https://service.cn-shenzhen.maxcompute.aliyun.com/api"
                    },
                    {
                        "label": "西南1(成都)",
                        "value": "https://service.cn-chengdu.maxcompute.aliyun.com/api"
                    },
                    {
                        "label": "中国(香港)",
                        "value": "https://service.cn-hongkong.maxcompute.aliyun.com/api"
                    },
                    {
                        "label": "新加坡",
                        "value": "https://service.ap-southeast-1.maxcompute.aliyun.com/api"
                    }
                ]
            },
            {
                "name": "project",
                "label": "执行 Project（非公共数据集/工作空间名）",
                "type": "text",
                "required": true
            },
            {
                "name": "schema",
                "label": "默认 Schema（可选）",
                "type": "text",
                "required": false
            },
            {
                "name": "schemaMode",
                "label": "Schema 模式",
                "type": "select",
                "required": false,
                "defaultValue": "AUTO",
                "options": [
                    {
                        "label": "自动识别（推荐）",
                        "value": "AUTO"
                    },
                    {
                        "label": "已启用 Schema",
                        "value": "ENABLED"
                    },
                    {
                        "label": "未启用 Schema",
                        "value": "DISABLED"
                    }
                ]
            },
            {
                "name": "connectTimeoutSeconds",
                "label": "连接超时（秒）",
                "type": "number",
                "required": true,
                "defaultValue": 15
            },
            {
                "name": "accessKeyId",
                "label": "AccessKey ID",
                "type": "text",
                "required": true
            },
            {
                "name": "accessKeySecret",
                "label": "AccessKey Secret",
                "type": "password",
                "required": true
            }
        ]
    },
