[
    {
        "dbType": "MYSQL",
        "displayName": "MySQL",
        "driverType": "jdbc",
        "driverClass": "com.mysql.cj.jdbc.Driver",
        "mavenCoordinates": {
            "groupId": "com.mysql",
            "artifactId": "mysql-connector-j",
            "version": "8.2.0"
        },
        "connectionUrlTemplate": "jdbc:mysql://{host}:{port}/{database}",
        "defaultPort": 3306,
        "capabilities": {
            "supportsTransaction": true,
            "supportsDML": true,
            "supportsDDL": true,
            "supportsPartition": false,
            "supportsViews": true,
            "supportsProcedures": true,
            "supportsFunctions": true,
            "supportsIndexes": true,
            "supportsTriggers": true,
            "supportsSSL": true,
            "readOnly": false
        },
        "connectionFormFields": [
            {
                "name": "host",
                "label": "主机地址",
                "type": "text",
                "required": true,
                "defaultValue": "localhost"
            },
            {
                "name": "port",
                "label": "端口",
                "type": "number",
                "required": true,
                "defaultValue": 3306
            },
            {
                "name": "connectTimeoutSeconds",
                "label": "\u8fde\u63a5\u8d85\u65f6\uff08\u79d2\uff09",
                "type": "number",
                "required": true,
                "defaultValue": 10
            },
            {
                "name": "database",
                "label": "数据库名",
                "type": "text",
                "required": false
            },
            {
                "name": "username",
                "label": "用户名",
                "type": "text",
                "required": true
            },
            {
                "name": "password",
                "label": "密码",
                "type": "password",
                "required": false
            },
            {
                "name": "sslMode",
                "label": "SSL 模式",
                "type": "select",
                "required": false,
                "defaultValue": "PREFERRED",
                "options": [
                    {
                        "label": "首选 SSL（兼容 DBeaver）",
                        "value": "PREFERRED"
                    },
                    {
                        "label": "必须使用 SSL",
                        "value": "REQUIRED"
                    },
                    {
                        "label": "校验证书",
                        "value": "VERIFY_CA"
                    },
                    {
                        "label": "校验证书和主机名",
                        "value": "VERIFY_IDENTITY"
                    },
                    {
                        "label": "禁用 SSL",
                        "value": "DISABLED"
                    }
                ]
            },
            {
                "name": "allowPublicKeyRetrieval",
                "label": "允许获取服务器 RSA 公钥（仅可信网络）",
                "type": "boolean",
                "required": false,
                "defaultValue": false
            }
        ]
    },
