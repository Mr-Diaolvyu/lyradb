            "supportsSSL": true,
            "readOnly": false
        },
        "connectionFormFields": [
            {
                "name": "protocol",
                "label": "传输协议",
                "type": "select",
                "required": true,
                "defaultValue": "https",
                "options": [
                    {
                        "label": "HTTPS（推荐）",
                        "value": "https"
                    },
                    {
                        "label": "HTTP（仅本机）",
                        "value": "http"
                    }
                ]
            },
            {
                "name": "host",
                "label": "主机地址",
                "type": "text",
                "required": true,
                "defaultValue": "localhost"
