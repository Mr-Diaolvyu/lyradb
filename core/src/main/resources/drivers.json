        "driverType": "jdbc",
        "driverClass": "com.clickhouse.jdbc.ClickHouseDriver",
        "mavenCoordinates": {
            "groupId": "com.clickhouse",
            "artifactId": "clickhouse-jdbc",
            "version": "0.6.0",
            "classifier": "http"
        },
        "connectionUrlTemplate": "jdbc:ch:{protocol}://{host}:{port}/{database}",
        "defaultPort": 8443,
        "capabilities": {
            "supportsTransaction": false,
            "supportsDML": true,
